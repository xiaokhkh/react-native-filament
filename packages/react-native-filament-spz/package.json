{
  "name": "react-native-filament-spz",
  "version": "0.0.0",
  "private": true,
  "description": "SPZ tooling, collision helpers, and scene utilities for react-native-filament.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "check:spz-material": "node bin/compile-spz-material.mjs --check",
    "compile:spz-material": "node bin/compile-spz-material.mjs",
    "compile:spz-material:tools": "node bin/compile-spz-material.mjs --download-tools --filament-version v1.50.0",
    "compile:spz-material:maven": "node bin/compile-spz-material.mjs --download-maven-matc --filament-version 1.72.0",
    "diagnose:matc": "node bin/compile-spz-material.mjs --diagnose-matc",
    "typescript": "tsc --noEmit"
  },
  "bin": {
    "compile-spz-material": "bin/compile-spz-material.mjs",
    "generate-spz-mobile-collision": "bin/generate-spz-mobile-collision.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react-native-filament": "workspace:^"
  }
}
