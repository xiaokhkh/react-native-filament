material {
    name : RNFGaussianSplat,
    parameters : [
        {
            type : float3,
            name : cameraPosition,
            precision : high
        },
        {
            type : float3,
            name : cameraRight,
            precision : high
        },
        {
            type : float3,
            name : cameraUp,
            precision : high
        },
        {
            type : float3,
            name : cameraForward,
            precision : high
        },
        {
            type : float2,
            name : renderSize,
            precision : high
        }
    ],
    blending : custom,
    blendFunction : {
        srcRGB : one,
        srcA : one,
        dstRGB : oneMinusSrcAlpha,
        dstA : oneMinusSrcAlpha
    },
    shadingModel : unlit,
    depthWrite : false,
    culling : none,
    vertexDomain : device,
    requires : [
        custom0,
        custom1,
        custom2,
        custom3,
        custom4
    ],
    variables : [
        {
            name : splatColor,
            precision : high
        },
        {
            name : splatUv,
            precision : high
        }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        const float maxStdDev = 2.828427;
        const float minPixelRadius = 0.0;
        const float maxPixelRadius = 512.0;
        const float preBlurAmount = 0.0;
        const float blurAmount = 0.3;
        const float minAlpha = 0.00196;
        const float alphaGain = 1.0;
        vec4 corner = getCustom0();
        vec3 axis0 = getCustom1().xyz;
        vec3 axis1 = getCustom2().xyz;
        vec3 axis2 = getCustom3().xyz;

        vec3 centerWorld = getPosition().xyz;
        vec3 rel = centerWorld - materialParams.cameraPosition;
        vec3 centerView = vec3(
            dot(rel, materialParams.cameraRight),
            dot(rel, materialParams.cameraUp),
            -dot(rel, materialParams.cameraForward)
        );
        vec3 axis0View = vec3(dot(axis0, materialParams.cameraRight), dot(axis0, materialParams.cameraUp), -dot(axis0, materialParams.cameraForward));
        vec3 axis1View = vec3(dot(axis1, materialParams.cameraRight), dot(axis1, materialParams.cameraUp), -dot(axis1, materialParams.cameraForward));
        vec3 axis2View = vec3(dot(axis2, materialParams.cameraRight), dot(axis2, materialParams.cameraUp), -dot(axis2, materialParams.cameraForward));
        mat4 clipFromView = getClipFromViewMatrix();
        vec4 centerClip = clipFromView * vec4(centerView, 1.0);
        if (centerView.z >= -0.0001 || abs(centerClip.z) >= centerClip.w) {
            material.clipSpaceTransform = mat4(vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0, 0.0, 2.0, 1.0));
            material.splatColor = vec4(0.0);
            material.splatUv = vec4(maxStdDev + 1.0, maxStdDev + 1.0, maxStdDev, 1.0);
            return;
        }

        vec2 scaledRenderSize = max(materialParams.renderSize, vec2(1.0));
        vec2 focal = 0.5 * scaledRenderSize * vec2(clipFromView[0][0], clipFromView[1][1]);
        float invZ = 1.0 / min(centerView.z, -0.0001);
        vec2 jacobianZ = -(focal * invZ * centerView.xy) * invZ;
        vec3 jacobianX = vec3(focal.x * invZ, 0.0, jacobianZ.x);
        vec3 jacobianY = vec3(0.0, focal.y * invZ, jacobianZ.y);

        vec3 projectedX = vec3(dot(jacobianX, axis0View), dot(jacobianX, axis1View), dot(jacobianX, axis2View));
        vec3 projectedY = vec3(dot(jacobianY, axis0View), dot(jacobianY, axis1View), dot(jacobianY, axis2View));
        float xx = dot(projectedX, projectedX);
        float xy = dot(projectedX, projectedY);
        float yy = dot(projectedY, projectedY);

        xx += preBlurAmount;
        yy += preBlurAmount;
        float detOrig = max(0.0, xx * yy - xy * xy);
        xx += blurAmount;
        yy += blurAmount;
        float det = max(0.000001, xx * yy - xy * xy);
        float blurAdjust = sqrt(max(0.0, detOrig / det));
        vec4 splatColor = getCustom4();
        float adjustedStdDev = maxStdDev;
        splatColor.a = min(splatColor.a * alphaGain, 1.0);
        splatColor.a *= blurAdjust;
        if (splatColor.a < minAlpha) {
            material.clipSpaceTransform = mat4(vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0, 0.0, 2.0, 1.0));
            material.splatColor = vec4(0.0);
            material.splatUv = vec4(maxStdDev + 1.0, maxStdDev + 1.0, maxStdDev, 1.0);
            return;
        }

        float halfTrace = 0.5 * (xx + yy);
        float discriminant = sqrt(max(0.0, halfTrace * halfTrace - det));
        float lambda0 = max(halfTrace + discriminant, 0.00000001);
        float lambda1 = max(halfTrace - discriminant, 0.00000001);
        vec2 ellipse0 = abs(xy) > 0.000001 ? normalize(vec2(xy, lambda0 - xx)) : (xx >= yy ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
        vec2 ellipse1 = vec2(ellipse0.y, -ellipse0.x);

        float radius0 = min(maxPixelRadius, adjustedStdDev * sqrt(lambda0));
        float radius1 = min(maxPixelRadius, adjustedStdDev * sqrt(lambda1));
        if (radius0 < minPixelRadius && radius1 < minPixelRadius) {
            material.clipSpaceTransform = mat4(vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0, 0.0, 2.0, 1.0));
            material.splatColor = vec4(0.0);
            material.splatUv = vec4(maxStdDev + 1.0, maxStdDev + 1.0, maxStdDev, 1.0);
            return;
        }
        vec2 pixelOffset = corner.x * radius0 * ellipse0 + corner.y * radius1 * ellipse1;
        vec2 ndcOffset = (2.0 / scaledRenderSize) * pixelOffset;
        material.clipSpaceTransform = mat4(vec4(0.0), vec4(0.0), vec4(0.0), vec4(centerClip.xy + ndcOffset * centerClip.w, centerClip.z, centerClip.w));
        material.splatColor = splatColor;
        material.splatUv = vec4(corner.xy * adjustedStdDev, adjustedStdDev, 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float r2 = dot(variable_splatUv.xy, variable_splatUv.xy);
        float adjustedStdDev = variable_splatUv.z;
        if (r2 > adjustedStdDev * adjustedStdDev) {
            discard;
        }
        float alpha = variable_splatColor.a * exp(-0.5 * r2);
        if (alpha < 0.00196) {
            discard;
        }

        material.baseColor = vec4(variable_splatColor.rgb * alpha, alpha);
    }
}
